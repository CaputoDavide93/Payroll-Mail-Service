# Copy to .env and fill in; or skip this and configure everything in the web UI.
# (docker-compose reads this file automatically.)

# --- Gmail / Google Workspace ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP hosts the web UI may use (comma-separated). Default: smtp.gmail.com,smtp-relay.gmail.com
# Set to * to allow any host (local dev only).
# SMTP_HOST_ALLOWLIST=smtp.gmail.com,smtp-relay.gmail.com
SMTP_USER=you@example.com
# 16-character App Password (NOT your normal password). See docs/setup.md for how to create one.
SMTP_PASS=xxxxxxxxxxxxxxxx
FROM_EMAIL=payroll@example.com
FROM_NAME=Payroll Team
# Seed only: false forces STARTTLS. Leave unset to derive it from the port (465 = SSL).
# SMTP_SECURE=

# Stay under your provider's daily cap. Workspace ~2000/day, free Gmail ~500/day.
DAILY_LIMIT=1800

# Protect the web UI with a password (recommended for cloud/public hosting).
# Leave blank for local-only use.
APP_PASSWORD=

# Optional: API key for an external AI service, used for AI payslip matching and the pre-flight review.
# If set, recipient names, emails and PDF filenames are sent to that service.
# Falls back to fuzzy matching if not provided.
ANTHROPIC_API_KEY=

# Payslip retention (payroll PII on disk).
# Delete each protected payslip PDF once it has been sent (set to false to keep them).
PAYSLIP_DELETE_AFTER_SEND=true
# Delete whole prepared runs (PDFs + results.json) this many days after preparation.
# Runs with recipients still pending are kept. 0 = never delete.
PAYSLIP_RETENTION_DAYS=7

# Set to 1 when running behind one reverse proxy (nginx, Caddy) so login throttling
# sees real client IPs and HSTS is sent over HTTPS. Leave blank when not proxied.
TRUST_PROXY=

# Port the app listens on (Docker Compose publishes the same port on the host).
PORT=3000

# Where the SQLite DB and uploads live for `npm start` (default: ./data).
# Docker always uses /data (the mail-data volume); Compose does not pass this through.
# DATA_DIR=data
