# Copy to .env and fill in — or skip this and configure everything in the web UI.
# (docker-compose reads this file automatically.)

# --- Gmail / Google Workspace ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP hosts the web UI may use (comma-separated). Default: smtp.gmail.com,smtp-relay.gmail.com
# Set to * to allow any host (local dev only).
# SMTP_HOST_ALLOWLIST=smtp.gmail.com,smtp-relay.gmail.com
SMTP_USER=you@example.com
# 16-character App Password (NOT your normal password). See README for how to create one.
SMTP_PASS=xxxxxxxxxxxxxxxx
FROM_EMAIL=payroll@example.com
FROM_NAME=Payroll Team

# Stay under your provider's daily cap. Workspace ~2000/day, free Gmail ~500/day.
DAILY_LIMIT=1800

# Protect the web UI with a password (recommended for cloud/public hosting).
# Leave blank for local-only use.
APP_PASSWORD=

# Optional: Anthropic API key for AI-powered payslip PDF matching.
# If set, Claude haiku is used to match PDF filenames to employee names.
# Falls back to fuzzy matching if not provided.
ANTHROPIC_API_KEY=

# Payslip retention (payroll PII on disk).
# Delete each protected payslip PDF once it has been sent (set to false to keep them).
PAYSLIP_DELETE_AFTER_SEND=true
# Delete whole prepared runs (PDFs + results.json) this many days after preparation.
# Runs with recipients still pending are kept. 0 = never delete.
PAYSLIP_RETENTION_DAYS=7
