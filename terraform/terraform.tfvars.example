# Copy to terraform.tfvars and fill in non-secret values.
# NEVER put secrets (app_password, smtp_pass, smtp_user, anthropic_api_key) here.
# Set those as environment variables:
#
#   export TF_VAR_app_password="..."
#   export TF_VAR_smtp_user="you@example.com"
#   export TF_VAR_smtp_pass="xxxx xxxx xxxx xxxx"
#   export TF_VAR_from_email="you@example.com"
#   export TF_VAR_anthropic_api_key="sk-ant-..."   # optional

aws_region  = "eu-west-1"
aws_profile = "default"
environment = "prod"

instance_type       = "t3.micro"
root_volume_size_gb = 20

# Restrict SSH to your IP for security — find it with: curl -s https://checkip.amazonaws.com
ssh_cidr = "0.0.0.0/0"

git_repo_url = "https://github.com/CaputoDavide93/Payroll-Mail-Service.git"
git_branch   = "main"

smtp_host   = "smtp.gmail.com"
smtp_port   = 465
from_name   = "Payroll Team"
daily_limit = 1800
