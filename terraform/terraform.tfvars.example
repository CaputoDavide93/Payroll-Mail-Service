# Copy to terraform.tfvars and fill in the non-secret values below.
#
# Secrets are stored in AWS Secrets Manager — set them as TF_VAR_* env vars
# so Terraform can populate the secret on first apply. Never put them here.
#
#   export TF_VAR_app_password="your-ui-password"
#   export TF_VAR_smtp_user="you@example.com"
#   export TF_VAR_smtp_pass="xxxx xxxx xxxx xxxx"
#   export TF_VAR_from_email="you@example.com"
#   export TF_VAR_anthropic_api_key="sk-ant-..."   # optional
#
# After apply, secrets live in:
#   AWS Secrets Manager → payroll-mail-service/prod/config
# The EC2 instance fetches them automatically at boot via its IAM role.

aws_region  = "eu-west-1"
aws_profile = "default"
environment = "prod"

instance_type       = "t3.micro"
root_volume_size_gb = 20

# Restrict SSH to your IP — find it: curl -s https://checkip.amazonaws.com
# (no default; prefer SSM Session Manager)
ssh_cidr = "203.0.113.10/32"

# HTTPS access to the instance (required: your office IPs)
office_cidrs = ["203.0.113.10/32", "198.51.100.20/32"]

# DNS (required): existing Route53 zone + the app hostname inside it
hosted_zone = "aws.example.com"
domain_name = "payroll.aws.example.com"

# allowed_account_ids = ["123456789012"]   # optional wrong-account guard
# acme_email   = ""   # optional Let's Encrypt contact


smtp_host   = "smtp.gmail.com"
smtp_port   = 465
from_name   = "Payroll Team"
daily_limit = 1800
